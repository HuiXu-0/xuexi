# 后端环境变量示例
# 复制为 .env 后修改。.env 不入库（已在 .gitignore 中）。

# ── 应用 ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── 数据库 ────────────────────────────────────────────
# MySQL 8.x。用 mysql+pymysql 驱动（同步 SQLAlchemy 2.0 风格）。
# charset 必须带 utf8mb4，否则中文与 emoji 会写入失败。
DATABASE_URL=mysql+pymysql://campus:campus_pwd@127.0.0.1:3306/campus_platform?charset=utf8mb4

# ── 认证 ──────────────────────────────────────────────
# 生产环境务必改成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-please-generate-a-real-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── 跨域 ──────────────────────────────────────────────
# 允许的前端来源。开发时是 Vite dev server，部署后是 GitHub Pages 地址。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://huixu-0.github.io

# ── 检索 ──────────────────────────────────────────────
# 是否启用向量检索。数据量小时关闭（见设计书 §4.5 的分阶段原则）。
# 开启需要配置 EMBEDDING_API_URL / EMBEDDING_API_KEY / EMBEDDING_MODEL。
ENABLE_VECTOR_SEARCH=false
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── LLM ───────────────────────────────────────────────
# 审核语义分析与搜索意图理解用。留空则相关接口返回 safe_fallback（见设计书 §9.4）。
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
